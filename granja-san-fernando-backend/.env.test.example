# Copia este archivo como .env.test y ajusta las credenciales de tu BD de PRUEBAS.
# Las pruebas BORRAN los datos de la base indicada: el nombre debe terminar en _test.
# Crea la BD con sql/00_esquema_base.sql y aplica las migraciones sql/02 a sql/06.
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_de_pruebas
DB_PASSWORD=contrasena_de_pruebas
DB_NAME=granja_test
JWT_SECRET=un-secreto-cualquiera-solo-para-pruebas
# Necesario: cada prueba simula una IP distinta para no chocar con el límite de intentos de login
TRUST_PROXY=1
